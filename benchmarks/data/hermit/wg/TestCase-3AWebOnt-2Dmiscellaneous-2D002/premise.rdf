<rdf:RDF
  xmlns     = "http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#"
  xmlns:food= "http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#"
  xml:base  = "http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#"
  xmlns:vin = "http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#"
  xmlns:owl = "http://www.w3.org/2002/07/owl#"
  xmlns:rdf = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs= "http://www.w3.org/2000/01/rdf-schema#">
<owl:Ontology rdf:about="">
    <rdfs:comment>An example OWL ontology</rdfs:comment>
    <owl:priorVersion>
      <owl:Ontology rdf:about="http://www.example.org/wine-020303"/>
    </owl:priorVersion>
    <owl:imports rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent002"/>
    <rdfs:comment>Derived from the DAML Wine ontology at 
      http://ontolingua.stanford.edu/doc/chimaera/ontologies/wines.daml
      Substantially changed, in particular the Region based relations.
    </rdfs:comment>
    <rdfs:label>Wine Ontology</rdfs:label>
  </owl:Ontology>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Wine">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent002#PotableLiquid" />
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasMaker" />
 <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasMaker" />
 <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Winery" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasSugar" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasFlavor" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasBody" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasColor" />
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#locatedIn"/> 
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Region"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">wine</rdfs:label>
    <rdfs:label xml:lang="fr">vin</rdfs:label>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Vintage">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasVintageYear"/>  
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineGrape">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent002#Grape" />
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WhiteWine">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Wine" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasColor" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#White" />
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WhiteTableWine">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#TableWine" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasColor" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#White" />
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WhiteNonSweetWine">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#WhiteWine" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasSugar" />
        <owl:allValuesFrom>
          <owl:Class>
            <owl:oneOf rdf:parseType="Collection">
              <owl:Thing rdf:about="#Dry" />
              <owl:Thing rdf:about="#OffDry" />
            </owl:oneOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WhiteLoire">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Loire" />
      <owl:Class rdf:about="#WhiteWine" />
    </owl:intersectionOf>
  </owl:Class>

  <owl:Class rdf:about="#WhiteLoire">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:allValuesFrom>
          <owl:Class>
            <owl:oneOf rdf:parseType="Collection">
              <owl:Thing rdf:about="#CheninBlancGrape" />
              <owl:Thing rdf:about="#PinotBlancGrape" />
              <owl:Thing rdf:about="#SauvignonBlancGrape" />
            </owl:oneOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WhiteBurgundy">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Burgundy" />
      <owl:Class rdf:about="#WhiteWine" />
    </owl:intersectionOf>
  </owl:Class>

  <owl:Class rdf:about="#WhiteBurgundy">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#ChardonnayGrape" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WhiteBordeaux">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Bordeaux" />
      <owl:Class rdf:about="#WhiteWine" />
    </owl:intersectionOf>
  </owl:Class>

  <owl:Class rdf:about="#WhiteBordeaux">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:allValuesFrom>
          <owl:Class>
            <owl:oneOf rdf:parseType="Collection">
              <owl:Thing rdf:about="#SemillonGrape" />
              <owl:Thing rdf:about="#SauvignonBlancGrape" />
            </owl:oneOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Region" />

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#locatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty" />
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Region" />
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#adjacentRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty" />
    <rdfs:domain rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Region" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Region" />
  </owl:ObjectProperty>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#VintageYear" />

  <owl:DatatypeProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#yearValue">
    <rdfs:domain rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#VintageYear" />    
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
  </owl:DatatypeProperty>
  
  <VintageYear rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Year1998">
    <yearValue rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1998</yearValue>
  </VintageYear>

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasVintageYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:domain rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Vintage" />
    <rdfs:range  rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#VintageYear" />
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent002#madeFromFruit" />
    <rdfs:domain rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Wine" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineGrape" />
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeIntoWine">
    <owl:inverseOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasWineDescriptor">
    <rdfs:domain rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Wine" />
    <rdfs:range  rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineDescriptor" />
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasSugar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasWineDescriptor" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineSugar" />
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasWineDescriptor" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineBody" />
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasFlavor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasWineDescriptor" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineFlavor" />
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasColor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasWineDescriptor" />
    <rdfs:domain rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Wine" />
    <rdfs:range rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineColor" />
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasMaker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#producesWine">
    <owl:inverseOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasMaker" />
  </owl:ObjectProperty>

  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Zinfandel">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Wine" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#ZinfandelGrape" />
      </owl:Restriction>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>
  
  <owl:Class rdf:about="#Zinfandel">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasColor" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Red" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasSugar" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Dry" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasBody" />
        <owl:allValuesFrom>
          <owl:Class>
            <owl:oneOf rdf:parseType="Collection">
              <owl:Thing rdf:about="#Full" />
              <owl:Thing rdf:about="#Medium" />
            </owl:oneOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasFlavor" />
        <owl:allValuesFrom>
          <owl:Class>
            <owl:oneOf rdf:parseType="Collection">
              <owl:Thing rdf:about="#Moderate" />
              <owl:Thing rdf:about="#Strong" />
            </owl:oneOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Winery" />
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineDescriptor">
    <rdfs:comment>Made WineDescriptor unionType of tastes and color</rdfs:comment>
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#WineTaste" />
      <owl:Class rdf:about="#WineColor" />
    </owl:unionOf>
  </owl:Class>

  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineTaste">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineDescriptor" />
  </owl:Class>

  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineColor">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineDescriptor" />
    <owl:oneOf rdf:parseType="Collection">
      <owl:Thing rdf:about="#White" />
      <owl:Thing rdf:about="#Rose" />
      <owl:Thing rdf:about="#Red" />
    </owl:oneOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineSugar">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineTaste" />
    <owl:oneOf rdf:parseType="Collection">
      <owl:Thing rdf:about="#Sweet" />
      <owl:Thing rdf:about="#OffDry" />
      <owl:Thing rdf:about="#Dry" />
    </owl:oneOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineFlavor">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineTaste" />
    <owl:oneOf rdf:parseType="Collection">
      <owl:Thing rdf:about="#Delicate" />
      <owl:Thing rdf:about="#Moderate" />
      <owl:Thing rdf:about="#Strong" />
    </owl:oneOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineBody">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#WineTaste" />
    <owl:oneOf rdf:parseType="Collection">
      <owl:Thing rdf:about="#Light" />
      <owl:Thing rdf:about="#Medium" />
      <owl:Thing rdf:about="#Full" />
    </owl:oneOf>
  </owl:Class>
  
  <Region rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#USRegion" />
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Tours">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Loire" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#locatedIn" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#ToursRegion" />
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>

  <owl:Class rdf:about="#Tours">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#CheninBlancGrape" />
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#madeFromGrape" />
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#TableWine">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Wine" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasSugar" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Dry" />
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#SweetWine">
    <owl:intersectionOf rdf:parseType="Collection">
      <owl:Class rdf:about="#Wine" />
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#hasSugar" />
        <owl:hasValue rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#Sweet" />
      </owl:Restriction>
    </owl:intersectionOf>
  </owl:Class>
  
  <owl:Class rdf:about="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#SweetRiesling">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/03owlt/miscellaneous/consistent001#DessertWine" />
    <rdfs:subClassOf>
      <owl:Restriction>
