Declaration(NamedIndividual(:sensor))Declaration(NamedIndividual(:kitchen))Declaration(NamedIndividual(:pda))Declaration(Class(:BluetoothSensor))Declaration(Class(:Location))Declaration(Class(:BluetoothDevice))Declaration(ObjectProperty(:hasLocation))Declaration(ObjectProperty(:detects))ClassAssertion(:BluetoothDevice :pda)
