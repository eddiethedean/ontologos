{
  "name": "ontologos",
  "version": "1.1.0",
  "description": "Node.js bindings for the OntoLogos OWL reasoner",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md"
  ],
  "napi": {
    "name": "ontologos",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "owl",
    "ontology",
    "reasoner",
    "semantic-web",
    "napi-rs"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddiethedean/ontologos.git",
    "directory": "crates/ontologos-node"
  },
  "homepage": "https://ontologos.readthedocs.io/",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
